# WhatsApp bridge sessions — auth.json holds linked-device key material
whatsapp-bridge/sessions/
whatsapp-bridge/session/
whatsapp-bridge/*.json
whatsapp-bridge/**/whatsapp_qr.png

# Runtime databases. These are generated (backend/seed_production.py) and were
# previously committed, which meant a clone started against a stale schema and
# shipped real conversation history with it.
data/*.db
data/*.db-shm
data/*.db-wal
# Voice engine output. Call logs carry beneficiary phone numbers and full
# Arabic transcripts, and the recordings are the calls themselves — the same
# class of data as sessions.db, which was committed once already.
data/voice.log
data/calls/
*.wav

# MCP config (may contain local/secret settings)
.mcp.json
