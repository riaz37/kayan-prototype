# Copy to .env and fill in. Everything here has a working default except the
# WhatsApp credentials, which are only needed to talk to the real Meta API.

# ---- LLM — any OpenAI-compatible endpoint (vLLM, OpenRouter, …)
# No real endpoint is committed here: fill this in locally, .env is gitignored.
LLM_BASE_URL=https://your-llm-host
LLM_MODEL=qwen
LLM_API_KEY=none
# This model emits chain-of-thought in a separate `reasoning` field. Thinking
# costs latency a WhatsApp reply cannot afford, so it is off by default.
LLM_ENABLE_THINKING=0
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Optional second model tried if the primary call fails. Leave empty to disable.
LLM_FALLBACK_MODEL=

# ---- service wiring
BACKEND_URL=http://127.0.0.1:8001
AGENT_URL=http://127.0.0.1:8002
# Where the SQLite database lives (Railway mounts a volume here).
DATA_DIR=./data

# ---- WhatsApp (Meta Cloud API) — only needed for real message delivery
WHATSAPP_VERIFY_TOKEN=kayan-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ---- Baileys bridge (unofficial WhatsApp, prototype only)
BRIDGE_PORT=8003

# ---- Voice / SIP engine (:8004)
VOICE_PORT=8004
# The SIP extension the agent answers on. Blank SIP_SERVER = no phone line,
# engine still serves the browser microphone. For the local FreeSWITCH rig
# see scripts/freeswitch_dev.sh.
SIP_SERVER=
SIP_PORT=5060
SIP_USERNAME=1001
SIP_PASSWORD=1234
SIP_LOCAL_PORT=15060
# Extension a call is handed to when the agent calls transfer_to_human.
SIP_TRANSFER_TARGET=1002

# ---- Speech (self-hosted, tailnet-only for now)
# nemotron :9027 — language auto: this model obeys `language` literally and
# Kayan's callers mix Arabic and English.
STT_BASE_URL=http://your-stt-host:9027/v1
STT_MODEL=nemotron-asr
STT_LANGUAGE=auto
# OmniVoice :9020 — the synthesis language is chosen per utterance, not here.
TTS_BASE_URL=http://your-tts-host:9020/v1
TTS_MODEL=k2-fsa/OmniVoice
TTS_VOICE=ar_female_warm.wav
TTS_NUM_STEP=16
