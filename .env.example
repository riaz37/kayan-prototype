# Copy to .env.local (git-ignored) and fill in. `./start.sh` loads .env then .env.local.

# ---- Console sign-in (first admin is created on first start, only while no account exists)
ADMIN_EMAIL=admin@kayan.org.sa
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_NAME=مدير النظام
ADMIN_NAME_EN=System admin

# ---- Service key the WhatsApp agent uses to call the backend API (any long random string)
AGENT_API_KEY=generate-a-long-random-string

# ---- Backend
BACKEND_URL=http://localhost:8000
# Comma-separated origins allowed to call the API directly ("*" disables credentialed CORS)
ALLOWED_ORIGINS=*

# ---- WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=kayan-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# ---- LLM for the agent
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
